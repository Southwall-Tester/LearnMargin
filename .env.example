# Optional. Copy to .env; learnmargin CLI loads it without overriding shell variables.
# Keys can also be entered in the browser for the current session only.
DEEPSEEK_API_KEY=
LEARNMARGIN_BASE_URL=https://api.deepseek.com
LEARNMARGIN_MODEL=deepseek-flash
LEARNMARGIN_PROTOCOL=chat_completions
# LEARNMARGIN_API_KEY=
# LEARNMARGIN_DATA_DIR=
# Optional legacy Office conversion. OS sandbox is mandatory; never falls back to an ordinary process.
# LEARNMARGIN_ALLOW_LOCAL_OFFICE=1
# Windows only. Configure with: learnmargin --setup-office
# LEARNMARGIN_OFFICE_WSL_DISTRIBUTION=LearnMargin-Office
